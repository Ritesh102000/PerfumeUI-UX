4a:["$","div","define-cream",{"data-reveal":true,"style":{"--reveal-delay":"160ms"},"children":["$","$L49",null,{"product":{"slug":"define-cream","name":"DEFINE CREAM","kind":"Hair","price":599,"mrp":799,"inStock":true,"hold":0.5,"shine":0.7,"holdLabel":"Light hold","finish":"Natural finish","bestFor":"Dry, tired-looking hair","cardLine":"Light, natural hold for everyday structure","short":"Bring Life Back to Tired Hair.","description":"Bring Life Back to Tired Hair.","benefits":["Light, natural hold for everyday structure","Subtle shine that makes hair look healthy, not greasy","Instantly improves dry, tired-looking hair","Softens, defines, and controls frizz","Ideal for relaxed, casual styles or layering under stronger products","Look fresher. Feel better. This is the product your hair needs when it’s saying nothing at all."],"ingredients":[{"name":"Beeswax","purpose":"Light flexible structure"},{"name":"Olive + avocado oil","purpose":"Hydration and softness"},{"name":"Shea butter","purpose":"Smoothness without heaviness"},{"name":"Wheat protein","purpose":"Supports texture and strength"}],"howTo":["Use on dry or slightly damp hair.","Distribute a small amount through your palms.","Smooth over the surface, then work through the ends.","Air-dry for softness or blow-dry for more shape."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/FLEWFL.png?v=1759849462","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/IYYG8OHIP.png?v=1759849462","video":"https://cdn.shopify.com/videos/c/vp/08d4a8e8ff034297ba49e0352bb43f38/08d4a8e8ff034297ba49e0352bb43f38.HD-720p-1.6Mbps-58657140.mp4?v=0","accent":"#4c807b","officialUrl":"https://haxxedgrooming.com/products/define-cream","ratingApproximate":true}}]}]
4b:["$","div","sculpting-cream",{"data-reveal":true,"style":{"--reveal-delay":"240ms"},"children":["$","$L49",null,{"product":{"slug":"sculpting-cream","name":"SCULPTING CLAY","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":4,"shine":1,"holdLabel":"Extreme hold","finish":"Soft matte","bestFor":"Fine or thin hair","cardLine":"Delivers extreme hold with a soft, touchable texture","short":"Effortless Texture.","description":"Effortless Texture. Maximum Hold. Zero Weight. Creating a high-textured hairstyle without the heaviness is no longer a challenge—meet Haxxed Sculpting Clay. This advanced, water-based formula delivers extreme hold while keeping your hair lightweight, soft, and touchable. Designed for flexibility, it lets you rework your style throughout the day without compromising hold, no matter the weather. Best for people with thin hair and don't want to feel tug & pull while applying the product.","benefits":["Delivers extreme hold with a soft, touchable texture","Creates volume and definition without the added weight","Reworkable throughout the day without compromising the hold","Lightweight, non-greasy, and easy to wash out","Made with clean, natural ingredients —no harsh chemicals","Perfect for fine hair or any style that needs structure with flexibility","Keeps both hair and scalp healthy, even with daily use"],"ingredients":[{"name":"Kaolin clay","purpose":"Texture and airy volume"},{"name":"Beeswax","purpose":"Strong flexible hold"},{"name":"Arrowroot","purpose":"Lightweight oil absorption"},{"name":"Shea + olive oil","purpose":"Conditioning and softness"}],"howTo":["Blow-dry hair into the direction you want for extra lift.","Warm a small amount completely between your palms.","Rake through from the back, then shape the front.","Layer gradually to avoid weighing down fine hair."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/87BHVNCWOE.png?v=1759848954","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/lsiefreff.png?v=1759848954","video":"https://cdn.shopify.com/videos/c/vp/d1424af397fb4cb29ae373c75531a1f4/d1424af397fb4cb29ae373c75531a1f4.HD-720p-1.6Mbps-58655097.mp4?v=0","accent":"#6d75be","officialUrl":"https://haxxedgrooming.com/products/sculpting-cream","ratingApproximate":false}}]}]
