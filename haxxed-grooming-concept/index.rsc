2b:["$","section",null,{"className":"company-intro content-frame","aria-labelledby":"company-intro-title","children":[["$","span",null,{"className":"company-intro__label","children":"About us"}],["$","div",null,{"className":"company-intro__layout","children":[["$","div",null,{"children":[["$","p",null,{"className":"micro-label","children":"Introducing"}],["$","h2",null,{"id":"company-intro-title","children":["HAXXED",["$","br",null,{}],"GROOMING CO."]}]]}],["$","div",null,{"className":"company-intro__copy","children":[["$","p",null,{"children":["At HAXXED Grooming Co., we believe styling should enhance your look ",["$","strong",null,{"children":"without harming your hair or scalp."}]," Born from a passion to bring ",["$","strong",null,{"children":"international quality products"}]," to India with ",["$","strong",null,{"children":"clean, performance-driven formulas,"}]," we create grooming essentials that deliver real results no harsh chemicals, fake claims, or heavy residue"]}],["$","p",null,{"children":["Every product is developed after extensive research to keep Indian hair types and climate in mind so you get ",["$","strong",null,{"children":"consistent performance in heat, humidity, and everyday life."}]]}]]}]]}]]}]
