2f:["$","section",null,{"className":"brand-story","id":"story","children":[["$","div",null,{"className":"brand-story__visual","data-reveal":true,"children":["$","img",null,{"src":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/DHVJGJBJ.png?v=1769092412&width=1600","alt":"Haxxed brand artwork for Indian men's grooming","loading":"lazy"}]}],["$","div",null,{"className":"brand-story__copy","data-reveal":true,"children":[["$","p",null,{"className":"micro-label","children":"How it all started"}],["$","h2",null,{"children":"A frustration became a formula."}],["$","p",null,{"children":"HAXXED Grooming Co began as Dehawk Manssentials, a brand that manufactured homemade/handmade styling products in India. It all started in 2019 when there were limited options for high-quality hairstyling brands in the market that delivered the results as claimed. The other alternative was to choose international products, which were often beyond the budget of many. So, we decided to bring international quality products to India that were made with clean and natural ingredients and delivered outstanding results."}],["$","p",null,{"children":"Our journey began with developing ideas and sourcing raw materials to produce thousands of samples. Countless samples were made and tested by ourselves until we created a product that performed well in all climatic conditions in India and delivered maximum results. We aimed to create products that offered nourishing benefits and used high-quality ingredients for maximum styling benefits."}],["$","div",null,{"className":"story-callout","children":[["$","span",null,{"children":"Made in / for India"}],["$","strong",null,{"children":"Performance, science and pride in one daily ritual."}]]}],["$","a",null,{"href":"/haxxed-grooming-concept/pages/our-story-1/","children":["Read the official story ",["$","$L8",null,{"ref":"$undefined","iconNode":"$2:1:props:children:props:children:props:children:3:props:children:0:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}]]}]
