2e:["$","section",null,{"className":"collection-preview content-frame","children":[["$","div",null,{"className":"section-heading","data-reveal":true,"children":[["$","div",null,{"children":[["$","p",null,{"className":"micro-label","children":"The first four"}],["$","h2",null,{"children":"Meet your styling bench."}]]}],["$","a",null,{"href":"/haxxed-grooming-concept/shop/","children":["See all 12 formulas ",["$","$L8",null,{"ref":"$undefined","iconNode":"$2:1:props:children:props:children:props:children:3:props:children:0:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}],["$","$L58",null,{"count":4,"children":[["$","div","clay-pomade",{"data-reveal":true,"style":{"--reveal-delay":"0ms"},"children":["$","$L59",null,{"product":{"slug":"clay-pomade","name":"CLAY POMADE","kind":"Hair","price":599,"mrp":799,"inStock":true,"hold":5,"shine":3,"holdLabel":"Extreme hold","finish":"Natural shine","bestFor":"Thick, dry hair","cardLine":"Extreme hold | Natural finish (oil based)","short":"The ultimate choice for those with thick and dry hair!","description":"The ultimate choice for those with thick and dry hair! Our preservative-free formula is crafted from 100% natural, high-quality ingredients including shea butter, olive oil, kaolin clay, and bentonite clay, providing unbeatable styling performance while nourishing your hair and scalp. With extreme hold, added thickness, texture, and volume, our clay pomade is also humidity and sweat resistant, ensuring a fresh and natural finish that lasts all day long.","benefits":["Extreme hold that lasts all day long","Natural shine for a clean, healthy look","Adds volume and texture from clay content","Oil-based formula, preservative-free and deeply conditioning","Ideal for structured & sculpted hairstyles","No flakes, no dryness, no compromises"],"ingredients":[{"name":"Kaolin + bentonite","purpose":"Dry grip, texture and volume"},{"name":"Beeswax","purpose":"Strong, flexible structure"},{"name":"Shea butter","purpose":"Softness and conditioning"},{"name":"Olive + coconut oil","purpose":"Nourishment and natural sheen"}],"howTo":["Start with dry or slightly damp hair.","Warm a fingertip-sized amount between both palms.","Work from roots to ends, then build only where you need more hold.","Use fingertips for texture or a comb for a cleaner shape."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/DNOBPM_S.png?v=1759848547","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/8ygiubj.png?v=1759848547","accent":"#6d625c","officialUrl":"https://haxxedgrooming.com/products/clay-pomade","ratingApproximate":false}}]}],["$","div","matte-paste",{"data-reveal":true,"style":{"--reveal-delay":"80ms"},"children":["$","$L59",null,{"product":{"slug":"matte-paste","name":"MATTE PASTE","kind":"Hair","price":599,"mrp":799,"inStock":true,"hold":5,"shine":1,"holdLabel":"High hold","finish":"True matte","bestFor":"Volume + definition","cardLine":"High hold | Matte finish","short":"Take control of your style with our Matte Paste, a high-hold clay formula designed to deliver serious grip, dry texture, and a true matte finish.","description":"Take control of your style with our Matte Paste, a high-hold clay formula designed to deliver serious grip, dry texture, and a true matte finish. Whether you're going for messy volume or sharp definition, this paste gives you all day hold without the shine.","benefits":["High hold for long-lasting control","Matte finish with zero shine","Adds volume and definition","Non-greasy, reworkable, and easy to wash out","Made with clean, nourishing ingredients"],"ingredients":[{"name":"Kaolin clay","purpose":"Absorbs excess oil and adds grip"},{"name":"Shea butter","purpose":"Keeps hair conditioned"},{"name":"Olive + avocado oil","purpose":"Softness without greasy shine"},{"name":"Vitamin E","purpose":"Antioxidant support for hair and scalp"}],"howTo":["Use on fully dry hair for the mattest result.","Emulsify a small amount until it disappears across your palms.","Push through roots for lift, then pinch sections for definition.","Rework with dry hands whenever the style needs a reset."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/SJFHEOHFDLSIJ.png?v=1759843172","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/jefyd3gdiy.png?v=1759843172","video":"https://cdn.shopify.com/videos/c/vp/c5dab9f48aa34fc98bb5cd571f3b5f77/c5dab9f48aa34fc98bb5cd571f3b5f77.HD-720p-1.6Mbps-58659315.mp4?v=0","accent":"#7a9b59","officialUrl":"https://haxxedgrooming.com/products/matte-paste","ratingApproximate":false}}]}],"$L5a","$L5b"]}]]}]
