22:["$","$L21","styling-wax",{"product":{"slug":"styling-wax","name":"STYLING WAX","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":3,"shine":2,"holdLabel":"Firm hold","finish":"Satin finish","bestFor":"Thin hair + flexible shapes","cardLine":"Medium hold | Satin finish","short":"Elevate your style with our High-Hold Satin Finish Hair Wax, made with a blend of premium natural ingredients.","description":"Elevate your style with our High-Hold Satin Finish Hair Wax, made with a blend of premium natural ingredients. It gives you powerful hold with a smooth, natural look — no greasiness, no stiffness. Infused with nutrient-rich oils and plant-based butters, this wax not only keeps your hairstyle in place but also nourishes your hair with every use.","benefits":["High hold for long-lasting control","Natural satin finish with minimal shine","Adds texture, volume, and definition","Non-greasy, reworkable, and easy to wash out","Made with premium, nourishing ingredients"],"ingredients":[{"name":"Plant butters","purpose":"Softness and easy distribution"},{"name":"Nutrient oils","purpose":"Conditioning and flexible sheen"}],"howTo":["Start with dry hair and a pea-sized amount.","Warm until the wax spreads clear across your hands.","Work from roots to ends with open palms.","Use fingertips to define the final outline."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/KJZXCBLWIENF.png?v=1759844315","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/wijferif.png?v=1759844315","accent":"#df6c3a","officialUrl":"https://haxxedgrooming.com/products/styling-wax","ratingApproximate":false}}]
