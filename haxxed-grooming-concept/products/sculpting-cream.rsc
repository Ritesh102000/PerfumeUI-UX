15:["$","section",null,{"className":"product-official content-frame","children":[["$","div",null,{"className":"section-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"micro-label","children":"The product, decoded"}],["$","h2",null,{"children":"SCULPTING CLAY"}]]}],["$","a",null,{"className":"text-cta","href":"https://haxxedgrooming.com/products/sculpting-cream","target":"_blank","rel":"noreferrer","children":["View on HAXXED ",["$","$L8",null,{"ref":"$undefined","iconNode":"$2:1:props:children:props:children:props:children:3:props:children:0:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"official-copy","children":[["$","p","0",{"children":["Effortless Texture. Maximum Hold. Zero Weight. Creating a high-textured hairstyle without the heaviness is no longer a challenge—meet Haxxed Sculpting Clay. This advanced, water-based formula delivers extreme hold while keeping your hair lightweight, soft, and touchable. Designed for flexibility, it lets you rework your style throughout the day without compromising hold, no matter the weather. Best for people with thin hair and don't want to feel tug & pull while applying the product."]}],["$","p","1",{"children":["Infused with clean, scalp-friendly ingredients, it nourishes as it styles, making it ideal for daily use. Whether you have fine hair or simply prefer a product that offers strong control with a soft finish, Haxxed Sculpting Clay gives you effortless texture, long-lasting shape, and a healthy look —all without the weight or buildup."]}],["$","p","2",{"children":["Whether you have fine hair or want serious structure with flexibility, this sculpting clay gives you control, texture, and a clean finish that lasts all day."]}],["$","h3","3",{"children":"Key Ingredients"}],["$","p","4",{"className":"official-copy__item","children":"Shea Butter – Deeply moisturizes and softens hair while reducing dryness and flakiness."}],["$","p","5",{"className":"official-copy__item","children":"Beeswax – Provides strong, flexible hold and helps lock in style without stiffness."}],["$","p","6",{"className":"official-copy__item","children":"Kaolin Clay – Adds natural texture and volume with a dry, matte finish."}],["$","p","7",{"className":"official-copy__item","children":"Arrowroot Powder – Absorbs excess oil and gives the hair a light, touchable feel."}],["$","p","8",{"className":"official-copy__item","children":"Olive Oil – Nourishes the scalp and adds healthy shine without weighing hair down."}],["$","p","9",{"className":"official-copy__item","children":"Glycerin – Draws in moisture to keep hair soft, manageable, and hydrated."}],["$","p","10",{"className":"official-copy__item","children":"Vitamin E – A powerful antioxidant that promotes scalp health and supports stronger hair."}],["$","h3","11",{"children":"Why You’ll Love It"}],["$","p","12",{"className":"official-copy__item","children":"Delivers extreme hold with a soft, touchable texture"}],["$","p","13",{"className":"official-copy__item","children":"Creates volume and definition without the added weight"}],["$","p","14",{"className":"official-copy__item","children":"Reworkable throughout the day without compromising the hold"}],["$","p","15",{"className":"official-copy__item","children":"Lightweight, non-greasy, and easy to wash out"}],["$","p","16",{"className":"official-copy__item","children":"Made with clean, natural ingredients —no harsh chemicals"}],["$","p","17",{"className":"official-copy__item","children":"Perfect for fine hair or any style that needs structure with flexibility"}],["$","p","18",{"className":"official-copy__item","children":"Keeps both hair and scalp healthy, even with daily use"}]]}]]}]
16:["$","section",null,{"className":"policy-notes content-frame","children":[["$","details",null,{"children":[["$","summary",null,{"children":["Delivery across India ",["$","span",null,{"children":"+"}]]}],["$","div",null,{"className":"official-copy","children":[["$","p","0",{"children":["At Haxxed Grooming Co., we aim to get your order to you as quickly and smoothly as possible."]}],["$","h3","1",{"children":"Order Processing & Dispatch"}],["$","p","2",{"className":"official-copy__item","children":"All orders are processed and dispatched within 1–2 working days after order placement."}],["$","h3","3",{"children":"Delivery Timeline"}],["$","p","4",{"className":"official-copy__item","children":"Once dispatched, delivery typically takes 2–5 business days, depending on your location."}],["$","p","5",{"className":"official-copy__item","children":"We ship all orders via air, ensuring faster transit across India."}],["$","p","6",{"className":"official-copy__item","children":"Delivery timelines may vary slightly during peak seasons, sales, or due to unforeseen courier delays."}],["$","h3","7",{"children":"Cash on Delivery (COD) Orders"}],["$","p","8",{"className":"official-copy__item","children":"COD orders are dispatched only after confirmation."}],["$","p","9",{"className":"official-copy__item","children":"A confirmation message will be sent to your registered mobile number via SMS or WhatsApp."}],["$","p","10",{"className":"official-copy__item","children":"Orders will be shipped only after you reply to confirm your COD order."}],["$","h3","11",{"children":"Shipping Charges"}],["$","p","12",{"className":"official-copy__item","children":"We offer FREE SHIPPING all over India — no minimum order value required."}],["$","h3","13",{"children":"Tracking & Shipping Updates"}],["$","p","14",{"className":"official-copy__item","children":"Once your order is shipped, you will receive tracking details via email."}],["$","p","15",{"className":"official-copy__item","children":"You can