/c5dab9f48aa34fc98bb5cd571f3b5f77/c5dab9f48aa34fc98bb5cd571f3b5f77.HD-720p-1.6Mbps-58659315.mp4?v=0","accent":"#7a9b59","officialUrl":"https://haxxedgrooming.com/products/matte-paste"}}],["$","$L1a","spiking-mud",{"product":{"slug":"spiking-mud","name":"Spiking Mud","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":4,"shine":1,"holdLabel":"High hold","finish":"Ultimate matte","bestFor":"Short, rugged texture","short":"Raw matte texture and a strong grip for bold, defined shapes.","description":"An earth-derived mud putty for short-to-medium hair, made to deliver a rugged dry finish, volume and high-hold definition.","benefits":["Strong dry grip","Ultimate matte finish","Adds rugged texture and lift","Lightweight, residue-conscious feel"],"ingredients":[{"name":"Kaolin + bentonite","purpose":"Dry volume and matte texture"},{"name":"Beeswax + plant wax","purpose":"Strong shaping control"},{"name":"Shea butter","purpose":"Softness and protection"},{"name":"Jojoba + argan oil","purpose":"Conditioning without overt shine"}],"howTo":["Use on dry short-to-medium hair.","Warm a small amount until evenly spread.","Push upward from the roots to create lift.","Twist or pinch individual sections for definition."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/OSCHEROV.png?v=1759851935","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/DSVBHseiv.png?v=1759851935","accent":"#586474","officialUrl":"https://haxxedgrooming.com/products/spiking-mud"}}],["$","$L1a","clay-pomade",{"product":{"slug":"clay-pomade","name":"Clay Pomade","kind":"Hair","price":599,"mrp":799,"inStock":true,"hold":5,"shine":3,"holdLabel":"Extreme hold","finish":"Natural shine","bestFor":"Thick, dry hair","short":"Extreme control with natural-looking texture and volume.","description":"A clay-forward pomade designed to give thick or dry hair serious structure, natural shine and weather-ready control without a rigid finish.","benefits":["Builds volume and separation","Humidity- and sweat-resistant hold","Flexible natural-looking finish","Water-soluble for an easier wash-out"],"ingredients":[{"name":"Kaolin + bentonite","purpose":"Dry grip, texture and volume"},{"name":"Beeswax","purpose":"Strong, flexible structure"},{"name":"Shea butter","purpose":"Softness and conditioning"},{"name":"Olive + coconut oil","purpose":"Nourishment and natural sheen"}],"howTo":["Start with dry or slightly damp hair.","Warm a fingertip-sized amount between both palms.","Work from roots to ends, then build only where you need more hold.","Use fingertips for texture or a comb for a cleaner shape."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/DNOBPM_S.png?v=1759848547","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/8ygiubj.png?v=1759848547","accent":"#6d625c","officialUrl":"https://haxxedgrooming.com/products/clay-pomade"}}]]}]]}]
