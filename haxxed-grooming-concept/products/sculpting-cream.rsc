1:["$","main",null,{"id":"top","className":"product-page","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/haxxed-grooming-concept/","children":"Home"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/haxxed-grooming-concept/shop/","children":"Shop"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"SCULPTING CLAY"}]]}],["$","section",null,{"className":"product-hero","children":[["$","aside",null,{"className":"purchase-panel","children":["$","div",null,{"className":"purchase-panel__inner","children":[["$","div",null,{"className":"purchase-kicker","children":[["$","span",null,{"children":["Hair"," styling"]}],["$","span",null,{"children":"Sold out"}]]}],["$","h1",null,{"children":"SCULPTING CLAY"}],["$","p",null,{"className":"purchase-description","children":"Effortless Texture. Maximum Hold. Zero Weight. Creating a high-textured hairstyle without the heaviness is no longer a challenge—meet Haxxed Sculpting Clay. This advanced, water-based formula delivers extreme hold while keeping your hair lightweight, soft, and touchable. Designed for flexibility, it lets you rework your style throughout the day without compromising hold, no matter the weather. Best for people with thin hair and don't want to feel tug & pull while applying the product."}],["$","div",null,{"className":"formula-meters","children":[["$","div","Hold",{"children":[["$","span",null,{"children":"Hold"}],["$","div",null,{"aria-label":"Hold: 4 out of 5","children":[["$","i","1",{"className":"is-filled"}],["$","i","2",{"className":"is-filled"}],["$","i","3",{"className":"is-filled"}],["$","i","4",{"className":"is-filled"}],["$","i","5",{"className":""}]]}],["$","strong",null,{"children":["",4,"/5"]}]]}],["$","div","Shine",{"children":[["$","span",null,{"children":"Shine"}],["$","div",null,{"aria-label":"Shine: 1 out of 5","children":[["$","i","1",{"className":"is-filled"}],["$","i","2",{"className":""}],["$","i","3",{"className":""}],["$","i","4",{"className":""}],["$","i","5",{"className":""}]]}],["$","strong",null,{"children":["",1,"/5"]}]]}]]}],["$","div",null,{"className":"purchase-price","children":[["$","strong",null,{"children":"₹599"}],[["$","del",null,{"children":["MRP ","₹799"]}],["$","span",null,{"children":["Save ","₹200"," · ",25,"% off"]}]],["$","small",null,{"children":"Inclusive of all taxes"}]]}],["$","$L11",null,{"product":{"slug":"sculpting-cream","name":"SCULPTING CLAY","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":4,"shine":1,"holdLabel":"Extreme hold","finish":"Soft matte","bestFor":"Fine or thin hair","cardLine":"Delivers extreme hold with a soft, touchable texture","short":"Effortless Texture.","description":"Effortless Texture. Maximum Hold. Zero Weight. Creating a high-textured hairstyle without the heaviness is no longer a challenge—meet Haxxed Sculpting Clay. This advanced, water-based formula delivers extreme hold while keeping your hair lightweight, soft, and touchable. Designed for flexibility, it lets you rework your style throughout the day without compromising hold, no matter the weather. Best for people with thin hair and don't want to feel tug & pull while applying the product.","benefits":["Delivers extreme hold with a soft, touchable texture","Creates volume and definition without the added weight","Reworkable throughout the day without compromising the hold","Lightweight, non-greasy, and easy to wash out","Made with clean, natural ingredients —no harsh chemicals","Perfect for fine hair or any style that needs structure with flexibility","Keeps both hair and scalp healthy, even with daily use"],"ingredients":[{"name":"Kaolin clay","purpose":"Texture and airy volume"},{"name":"Beeswax","purpose":"Strong flexible hold"},{"name":"Arrowroot","purpose":"Lightweight oil absorption"},{"name":"Shea + olive oil","purpose":"Conditioning and softness"}],"howTo":["Blow-dry hair into the direction you want for extra lift.","Warm a small amount completely between your palms.","Rake through from the back, then shape the front.","Layer gradually to avoid weighing down fine hair."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/87BHVNCWOE.png?v=1759848954","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/lsiefreff.png?v=1759848954","video":"https://cdn.shopify.com/videos/c/vp/d1424af397fb4cb29ae373c75531a1f4/d1424af397fb4cb29ae373c75531a1f4.HD-720p-1.6Mbps-58655097.mp4?v=0","accent":"#6d75be","officialUrl":"https://haxxedgrooming.com/products/sculpting-cream","ratingApproximate":false}}],"$L12","$L13"]}]}],"$L14"]}],"$L15","$L16","$L17"]}]
