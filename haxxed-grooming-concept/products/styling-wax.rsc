1b:["$","section",null,{"className":"company-origin","children":[["$","div",null,{"className":"company-origin__image","data-reveal":true,"children":[["$","img",null,{"src":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/DHVJGJBJ.png?v=1769092412&width=1600","alt":"HAXXED founder and grooming brand story","loading":"lazy"}],["$","span",null,{"children":"India / Since 2019"}]]}],["$","div",null,{"className":"company-origin__copy","data-reveal":true,"children":[["$","p",null,{"className":"micro-label","children":"Why HAXXED is here"}],["$","h2",null,{"children":"International-quality styling. Made for India."}],["$","p",null,{"children":"HAXXED began in 2019 as Dehawk Manssentials after its founder found a gap between limited local styling options and expensive imported products. The aim was simple: build high-performance grooming formulas around Indian hair, weather and everyday routines."}],["$","p",null,{"children":"After 18 months of research, thousands of samples and testing across Indian climatic conditions, that idea became HAXXED—a clean, water-soluble styling range built to nourish as it shapes."}],["$","a",null,{"href":"https://haxxedgrooming.com/pages/our-story-1","target":"_blank","rel":"noreferrer","children":["Read the official HAXXED story ",["$","$L8",null,{"ref":"$undefined","iconNode":"$2:1:props:children:props:children:props:children:3:props:children:0:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}]]}]
