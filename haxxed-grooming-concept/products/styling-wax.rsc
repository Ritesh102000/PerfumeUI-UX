16:["$","section",null,{"className":"product-official content-frame","children":[["$","div",null,{"className":"section-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"micro-label","children":"The product, decoded"}],["$","h2",null,{"children":"STYLING WAX"}]]}],["$","a",null,{"className":"text-cta","href":"https://haxxedgrooming.com/products/styling-wax","target":"_blank","rel":"noreferrer","children":["View on HAXXED ",["$","$L8",null,{"ref":"$undefined","iconNode":"$2:1:props:children:props:children:props:children:3:props:children:0:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"product-content-sections","children":[["$","details","0",{"children":[["$","summary",null,{"children":["Description",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"official-copy","children":[["$","p","0",{"children":["Elevate your style with our High-Hold Satin Finish Hair Wax, made with a blend of premium natural ingredients. It gives you powerful hold with a smooth, natural look — no greasiness, no stiffness. Infused with nutrient-rich oils and plant-based butters, this wax not only keeps your hairstyle in place but also nourishes your hair with every use."]}]]}]]}],["$","details","1",{"children":[["$","summary",null,{"children":["Key Benefits",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"official-copy","children":[["$","p","0",{"className":"official-copy__item","children":"High hold for long-lasting control"}],["$","p","1",{"className":"official-copy__item","children":"Natural satin finish with minimal shine"}],["$","p","2",{"className":"official-copy__item","children":"Adds texture, volume, and definition"}],["$","p","3",{"className":"official-copy__item","children":"Non-greasy, reworkable, and easy to wash out"}],["$","p","4",{"className":"official-copy__item","children":"Made with premium, nourishing ingredients"}]]}]]}],["$","details","2",{"children":[["$","summary",null,{"children":["Why You’ll Love It",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"official-copy","children":[["$","p","0",{"className":"official-copy__item","children":"Strong, all-day hold without stiffness or crunch"}],["$","p","1",{"className":"official-copy__item","children":"Satin-matte finish for a natural, effortless look"}],["$","p","2",{"className":"official-copy__item","children":"Adds volume, texture, and structure with ease"}],["$","p","3",{"className":"official-copy__item","children":"Non-greasy and lightweight — won’t weigh hair down"}],["$","p","4",{"className":"official-copy__item","children":"Easy to apply and rework, perfect for touch-ups"}],["$","p","5",{"className":"official-copy__item","children":"Rinses out easily with just water"}],["$","p","6",{"className":"official-copy__item","children":"Made with clean, nourishing ingredients — gentle on scalp"}],["$","p","7",{"children":["Haxxed Styling Wax is the ultimate solution for those with thin or extremely thin hair who want a firm hold without the added weight. We understand that using heavy products can be damaging to thin hair, as it is prone to breakage. That's why our styling wax is super lightweight, making it perfect for people with thin hair. You can apply it effortlessly without any tug or pull, ensuring a gentle experience for your hair."]}],["$","p","8",{"children":["Our styling wax offers ultra-flexible hold, allowing you to change your hairstyle at any point in time without compromising on the hold. Plus, it's water-soluble, making it incredibly easy to wash out with just water. Rest assured, our styling wax is non-harmful for your hair and is designed for daily use without harming your scalp or hair health. It's soft, gentle, and long-lasting, providing you with the perfect hold for your desired hairstyle. Elevate your styling game with Haxxed styling wax and achieve the look you've always wanted."]}]]}]]}]]}]]}]
