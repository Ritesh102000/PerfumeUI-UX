1c:["$","$L1b","texture-paste",{"product":{"slug":"texture-paste","name":"TEXTURE PASTE","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":2,"shine":1,"holdLabel":"Medium hold","finish":"Matte texture","bestFor":"Short to medium hair","cardLine":"Tons of texture with a dry, matte finish","short":"Shape.","description":"Shape. Define. Texture That Lasts.","benefits":["Tons of texture with a dry, matte finish","Medium hold that’s flexible and reworkable","Natural ingredients, no silicones or synthetic waxes","Works best on short to medium-length hair","Washes out easily with water","Style it messy, shape it clean, or build natural volume—this paste does it all, without the shine."],"ingredients":[{"name":"Kaolin + bentonite","purpose":"Dry texture and grip"},{"name":"Arrowroot + starch","purpose":"Oil absorption and lightness"},{"name":"Almond + olive oil","purpose":"Keeps hair soft"},{"name":"Bamboo + wheat protein","purpose":"Supports texture and strength"}],"howTo":["Apply to dry hair for the cleanest matte finish.","Spread a small amount across fingers and palms.","Scrunch, rake or pinch depending on the texture you want.","Add sparingly to build hold without flattening volume."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/SSUCBASLNC.png?v=1759843064","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/Render_Mockup_1920_1920_2025-10-01.jpg?v=1759843064","video":"https://cdn.shopify.com/videos/c/vp/f11cc20ea4ff40d7951a4f0f8cdf43e9/f11cc20ea4ff40d7951a4f0f8cdf43e9.HD-720p-1.6Mbps-58649845.mp4?v=0","accent":"#c64539","officialUrl":"https://haxxedgrooming.com/products/texture-paste","ratingApproximate":false}}]
