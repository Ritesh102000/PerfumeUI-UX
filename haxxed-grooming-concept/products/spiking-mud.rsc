/c5dab9f48aa34fc98bb5cd571f3b5f77/c5dab9f48aa34fc98bb5cd571f3b5f77.HD-720p-1.6Mbps-58659315.mp4?v=0","accent":"#7a9b59","officialUrl":"https://haxxedgrooming.com/products/matte-paste"}}],["$","$L1a","sculpting-cream",{"product":{"slug":"sculpting-cream","name":"Sculpting Clay","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":5,"shine":1,"holdLabel":"Extreme hold","finish":"Soft matte","bestFor":"Fine or thin hair","short":"Maximum shape with a lightweight, soft and restylable feel.","description":"A water-based sculpting clay that brings serious control to fine hair while staying light, soft and easy to restyle.","benefits":["High texture without heaviness","Extreme, flexible hold","Low-tug application","Water-based and reworkable"],"ingredients":[{"name":"Kaolin clay","purpose":"Texture and airy volume"},{"name":"Beeswax","purpose":"Strong flexible hold"},{"name":"Arrowroot","purpose":"Lightweight oil absorption"},{"name":"Shea + olive oil","purpose":"Conditioning and softness"}],"howTo":["Blow-dry hair into the direction you want for extra lift.","Warm a small amount completely between your palms.","Rake through from the back, then shape the front.","Layer gradually to avoid weighing down fine hair."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/87BHVNCWOE.png?v=1759848954","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/lsiefreff.png?v=1759848954","video":"https://cdn.shopify.com/videos/c/vp/d1424af397fb4cb29ae373c75531a1f4/d1424af397fb4cb29ae373c75531a1f4.HD-720p-1.6Mbps-58655097.mp4?v=0","accent":"#6d75be","officialUrl":"https://haxxedgrooming.com/products/sculpting-cream"}}],["$","$L1a","styling-wax",{"product":{"slug":"styling-wax","name":"Styling Wax","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":4,"shine":2,"holdLabel":"Firm hold","finish":"Satin finish","bestFor":"Thin hair + flexible shapes","short":"A flexible, lightweight wax with a calm satin finish.","description":"A lightweight, water-soluble wax that gives thin hair a firm but flexible shape with a restrained satin finish.","benefits":["Firm flexible control","Light satin finish","Designed for low-tug application","Water-soluble styling"],"ingredients":[{"name":"Plant butters","purpose":"Softness and easy distribution"},{"name":"Nutrient oils","purpose":"Conditioning and flexible sheen"}],"howTo":["Start with dry hair and a pea-sized amount.","Warm until the wax spreads clear across your hands.","Work from roots to ends with open palms.","Use fingertips to define the final outline."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/KJZXCBLWIENF.png?v=1759844315","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/wijferif.png?v=1759844315","accent":"#df6c3a","officialUrl":"https://haxxedgrooming.com/products/styling-wax"}}]]}]]}]
