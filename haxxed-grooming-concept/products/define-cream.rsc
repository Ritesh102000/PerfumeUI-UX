19:["$","section",null,{"className":"policy-notes content-frame","children":[["$","details",null,{"children":[["$","summary",null,{"children":["Delivery across India ",["$","span",null,{"children":"+"}]]}],["$","div",null,{"className":"official-copy","children":[["$","p","0",{"children":["At Haxxed Grooming Co., we aim to get your order to you as quickly and smoothly as possible."]}],["$","h3","1",{"children":"Order Processing & Dispatch"}],["$","p","2",{"className":"official-copy__item","children":"All orders are processed and dispatched within 1–2 working days after order placement."}],["$","h3","3",{"children":"Delivery Timeline"}],["$","p","4",{"className":"official-copy__item","children":"Once dispatched, delivery typically takes 2–5 business days, depending on your location."}],["$","p","5",{"className":"official-copy__item","children":"We ship all orders via air, ensuring faster transit across India."}],["$","p","6",{"className":"official-copy__item","children":"Delivery timelines may vary slightly during peak seasons, sales, or due to unforeseen courier delays."}],["$","h3","7",{"children":"Cash on Delivery (COD) Orders"}],["$","p","8",{"className":"official-copy__item","children":"COD orders are dispatched only after confirmation."}],["$","p","9",{"className":"official-copy__item","children":"A confirmation message will be sent to your registered mobile number via SMS or WhatsApp."}],["$","p","10",{"className":"official-copy__item","children":"Orders will be shipped only after you reply to confirm your COD order."}],["$","h3","11",{"children":"Shipping Charges"}],["$","p","12",{"className":"official-copy__item","children":"We offer FREE SHIPPING all over India — no minimum order value required."}],["$","h3","13",{"children":"Tracking & Shipping Updates"}],["$","p","14",{"className":"official-copy__item","children":"Once your order is shipped, you will receive tracking details via email."}],["$","p","15",{"className":"official-copy__item","children":"You can