1d:["$","$L1c","spiking-mud",{"product":{"slug":"spiking-mud","name":"SPIKING MUD","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":3,"shine":1,"holdLabel":"High hold","finish":"Ultimate matte","bestFor":"Short, rugged texture","cardLine":"🌿 100% naturally derived styling base","short":"Strong grip.","description":"Strong grip. Matte texture. Naturally bold.","benefits":["🌿 100% naturally derived styling base","💪 Strong, long-lasting hold","🌑 Dry matte finish – zero shine","✋ Reworkable texture for natural movement","🚫 No parabens, silicones, or synthetic build-up","✅ Suitable for short to medium hair"],"ingredients":[{"name":"Kaolin + bentonite","purpose":"Dry volume and matte texture"},{"name":"Beeswax + plant wax","purpose":"Strong shaping control"},{"name":"Shea butter","purpose":"Softness and protection"},{"name":"Jojoba + argan oil","purpose":"Conditioning without overt shine"}],"howTo":["Use on dry short-to-medium hair.","Warm a small amount until evenly spread.","Push upward from the roots to create lift.","Twist or pinch individual sections for definition."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/OSCHEROV.png?v=1759851935","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/DSVBHseiv.png?v=1759851935","accent":"#586474","officialUrl":"https://haxxedgrooming.com/products/spiking-mud","ratingApproximate":false}}]
