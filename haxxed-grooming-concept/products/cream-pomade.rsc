,"officialUrl":"https://haxxedgrooming.com/products/clay-pomade"}}],["$","$L1a","moulding-gel",{"product":{"slug":"moulding-gel","name":"Moulding Gel","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":5,"shine":5,"holdLabel":"Maximum hold","finish":"Wet look","bestFor":"Glossy, set styles","short":"Maximum hold and a high-gloss wet finish without flakes.","description":"A fast-setting moulding gel for defined wet looks, polished shape and strong control with a non-flaking finish.","benefits":["Maximum long-lasting hold","High-gloss wet finish","Fast setting without crunch overload","Alcohol- and silicone-free formula"],"ingredients":[{"name":"Aloe vera juice","purpose":"Hydration and scalp comfort"},{"name":"Flaxseed extract","purpose":"Natural hold and shine"},{"name":"Plant glycerin","purpose":"Moisture retention"},{"name":"Natural polymers","purpose":"Strong flexible hold"}],"howTo":["Apply to damp hair for an even wet finish.","Spread a small amount across both hands.","Comb or rake through quickly before it sets.","Allow to dry, then avoid over-touching for maximum shine."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/JDAOSDVEA.png?v=1759852812","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/lshw3el.png?v=1759852812","accent":"#336ca0","officialUrl":"https://haxxedgrooming.com/products/moulding-gel"}}],["$","$L1a","matte-paste",{"product":{"slug":"matte-paste","name":"Matte Paste","kind":"Hair","price":599,"mrp":799,"inStock":true,"hold":5,"shine":1,"holdLabel":"High hold","finish":"True matte","bestFor":"Volume + definition","short":"Dry grip, high hold and a reworkable no-shine finish.","description":"A high-hold paste that adds grip, shape and volume while keeping the finish genuinely matte and touchably reworkable.","benefits":["True matte finish","Strong but reworkable hold","Adds dry texture and definition","Clean, lightweight feel"],"ingredients":[{"name":"Kaolin clay","purpose":"Absorbs excess oil and adds grip"},{"name":"Shea butter","purpose":"Keeps hair conditioned"},{"name":"Olive + avocado oil","purpose":"Softness without greasy shine"},{"name":"Vitamin E","purpose":"Antioxidant support for hair and scalp"}],"howTo":["Use on fully dry hair for the mattest result.","Emulsify a small amount until it disappears across your palms.","Push through roots for lift, then pinch sections for definition.","Rework with dry hands whenever the style needs a reset."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/SJFHEOHFDLSIJ.png?v=1759843172","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/jefyd3gdiy.png?v=1759843172","video":"https://cdn.shopify.com/videos/c/vp/c5dab9f48aa34fc98bb5cd571f3b5f77/c5dab9f48aa34fc98bb5cd571f3b5f77.HD-720p-1.6Mbps-58659315.mp4?v=0","accent":"#7a9b59","officialUrl":"https://haxxedgrooming.com/products/matte-paste"}}]]}]]}]
