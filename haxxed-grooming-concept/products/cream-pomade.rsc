1b:["$","$L1a","styling-clay",{"product":{"slug":"styling-clay","name":"STYLING CLAY","kind":"Hair","price":599,"mrp":799,"inStock":false,"hold":3,"shine":4,"holdLabel":"High hold","finish":"Natural finish","bestFor":"Structured flexible looks","cardLine":"Strong, reliable hold with light natural shine","short":"Lock in your style with our Styling Clay, crafted to deliver high hold with just a hint of natural shine —never dry, never crunchy.","description":"Lock in your style with our Styling Clay, crafted to deliver high hold with just a hint of natural shine —never dry, never crunchy. This clay glides on smoothly, giving you structured definition and lasting control, while still being flexible and easy to work through.","benefits":["Strong, reliable hold with light natural shine","Creamy texture that’s easy to apply and rework","Not overly dry—perfect balance of grit and moisture","Ideal for classic, slick, or modern textured styles","Free of petroleum, parabens, and synthetic fillers"],"ingredients":[{"name":"Kaolin + bentonite","purpose":"Texture and grip"},{"name":"Beeswax","purpose":"Flexible structure"},{"name":"Shea + mango butter","purpose":"Softness and conditioning"},{"name":"Olive + avocado oil","purpose":"Natural sheen and manageability"}],"howTo":["Start on dry hair for the strongest control.","Warm thoroughly to soften the clay.","Work through roots and lengths in small passes.","Finish with fingers to keep the style flexible."],"image":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/OIGJ4PIJF.png?v=1759851893","altImage":"https://cdn.shopify.com/s/files/1/0723/0128/1561/files/XFBGDNFJB_1ba9ba67-04ff-4d3a-aa06-97064bf287b1.png?v=1759851893","accent":"#775b55","officialUrl":"https://haxxedgrooming.com/products/styling-clay","ratingApproximate":false}}]
